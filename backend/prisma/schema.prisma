generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER 
  ADMIN
}

enum Status {
  COMPLETED
  PENDING
  CANCELED
}

model User{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  email String @unique
  name String
  telephone String
  password String
  role Role @default(USER)
  agendamento Agendamento[]
  createdAt DateTime @default(now())
}

model Servico{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String
  description String
  value Float
  agendamentoServico AgendamentoServico[]
}

model Agendamento{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  user User @relation(fields: [userId], references: [id])
  userId String
  status Status @default(PENDING)
  selectedDate DateTime
  selectedTime String
  totalValue Float
  createdAt DateTime @default(now())
  agendamentoServico AgendamentoServico[]
}

model AgendamentoServico{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id])
  agendamentoId String
  servico Servico @relation(fields: [serviceId], references: [id])
  serviceId String

  @@unique([agendamentoId, serviceId])
}

